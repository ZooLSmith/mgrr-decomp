// ray request built on the stack (0x38 bytes)
struct RayRequest {
    float from[4];
    float to[4];
    unsigned int flags;  // 0xFFFF0006
    int field24;
    int mask28;          // 0x60
    int field2C;
    const char *name;
    int field34;
};

// QTE safe check: takes the pending target point `slot` (float[4], reset to (0,0,0,1)); when it is
// not zero, casts a ray from the player to it and one back (both 1.5 higher); if either hits,
// the player is placed with vf7C(point, vf84()).  Body of FUN_00b89850 / qteZangekiSafeCheckForward.
inline void qteSafeCheck(Pl0000 *self, float *slot, const char *forwardName, const char *returnName)
{
    float point[4];
    point[0] = slot[0];
    point[1] = slot[1];
    point[2] = slot[2];
    point[3] = slot[3];
    slot[0] = 0.0f;
    slot[1] = 0.0f;
    slot[2] = 0.0f;
    slot[3] = 1.0f;
    if (point[0] == 0.0f && point[1] == 0.0f && point[2] == 0.0f) {
        return;
    }
    float *pos = self->matrix() + 12;  // position row (+0x40)
    RayRequest forward;
    forward.from[0] = pos[0];
    forward.from[1] = pos[1] + 1.5f;
    forward.from[2] = pos[2];
    forward.from[3] = pos[3];
    forward.to[0] = point[0];
    forward.to[1] = point[1] + 1.5f;
    forward.to[2] = point[2];
    forward.to[3] = point[3];
    forward.flags = 0xFFFF0006;
    forward.field24 = 0;
    forward.mask28 = 0x60;
    forward.field2C = 0;
    forward.name = forwardName;
    forward.field34 = 0;
    RayRequest back;
    back.from[0] = point[0];
    back.from[1] = point[1] + 1.5f;
    back.from[2] = point[2];
    back.from[3] = point[3];
    back.to[0] = pos[0];
    back.to[1] = pos[1] + 1.5f;
    back.to[2] = pos[2];
    back.to[3] = pos[3];
    back.flags = 0xFFFF0006;
    back.field24 = 0;
    back.mask28 = 0x60;
    back.field2C = 0;
    back.name = returnName;
    back.field34 = 0;
    unsigned char hit[16];
    unsigned char work[28];
    if (rayCast(DAT_01b35df8, hit, work, 0, 0, &forward) != 0 ||
        rayCast(DAT_01b35df8, hit, work, 0, 0, &back) != 0) {
        self->vf7C((undefined4)point, (undefined4)self->vf84());
    }
}

// Clears the object of FUN_00d82980(0x44) state: FUN_00d82de0(field7D0) and the qte object fields
// +0x3EC / +0x3F0 / +0x188 (inlined in FUN_00b8a140 / FUN_00b8c170).
inline void resetQteLink(Pl0000 *self, int setFlag2F0)
