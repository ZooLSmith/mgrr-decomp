}

// strcmp(a, b) == 0 (inlined byte loop in the original)
inline bool sameName(const char *a, const char *b)
{
    for (;;) {
        if (*a != *b) {
            return false;
        }
        if (*a == 0) {
            return true;
        }
        a++;
        b++;
    }
}

// Sets (on) or clears bit 0 of the flags (+0x38) of every mesh entry (0x70 bytes, name at
// entry+0x60 -> +0x40) of `model` whose name is `name`.  The count and the array are re-read
// every iteration, as in the original.
inline void setMeshFlag(cModelBase *model, const char *name, bool on)
{
    for (int i = 0; i < model->meshCount(); i++) {
        char *entry = (char *)model->meshArray() + i * 0x70;
        const char *meshName = *(const char **)(*(int *)(entry + 0x60) + 0x40);
        if (meshName != 0 && sameName(meshName, name)) {
            if (on) {
                *(unsigned int *)(entry + 0x38) |= 1;
            } else {
                *(unsigned int *)(entry + 0x38) &= 0xFFFFFFFE;
            }
        }
    }
}

// Normalizes the xyz of `v` (FUN_00ddf460) when it is not zero; a zero-length result is reported
// with FUN_00dd5650 and, when `reset`, replaced by (0, 1, 0).
inline void normalizeOrWarn(float *v, bool reset)
{
    if (v[0] == 0.0f && v[1] == 0.0f && v[2] == 0.0f) {
        return;
    }
    float lengthSq = v[2] * v[2] + v[0] * v[0] + v[1] * v[1];
    if (!(lengthSq <= 0.0f)) {
        FUN_00ddf460(v, v);
    } else {
        call_00DD5650(DAT_0163d0ac);
        if (reset) {
            v[0] = 0.0f;
            v[1] = 1.0f;
            v[2] = 0.0f;
        }
    }
}

// Matrix of the Euler angles (x, y, z) returned by vf84: identity, then R(z), R(y), R(x) each
// multiplied in front (M = R * M) when the angle is not 0.
inline void eulerMatrix(Pl0000 *self, float *m)
{
    float *rot = (float *)self->vf84();
    float r[16];
    for (int i = 0; i < 16; i++) {
        m[i] = 0.0f;
    }
    m[0] = 1.0f;
    m[5] = 1.0f;
    m[10] = 1.0f;
    m[15] = 1.0f;
    if (rot[2] != 0.0f) {
        D3DXMatrixRotationZ(r, rot[2]);
        D3DXMatrixMultiply(m, r, m);
    }
    if (rot[1] != 0.0f) {
        D3DXMatrixRotationY(r, rot[1]);
        D3DXMatrixMultiply(m, r, m);
    }
    if (rot[0] != 0.0f) {
        D3DXMatrixRotationX(r, rot[0]);
        D3DXMatrixMultiply(m, r, m);
    }
}

