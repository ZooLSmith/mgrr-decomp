}
// Hides the meshes whose name contains `part` (FUN_00fdbbd0: strstr).
inline void hideMeshesContaining(void *model, const char *part)
{
    for (int i = 0; i < ((cModelBase *)model)->meshCount(); i++) {
        char *entry = meshEntry(model, i);
        char *name = meshName(entry);
        if (name != 0 && FUN_00fdbbd0((uint *)name, (char *)part) != 0) {
            *(unsigned int *)(entry + 0x38) = *(unsigned int *)(entry + 0x38) & 0xFFFFFFFE;
        }
    }
}
// Hides the meshes named exactly `wanted` (strcmp inlined in the original).
inline void hideMeshesNamed(void *model, const char *wanted)
{
    for (int i = 0; i < ((cModelBase *)model)->meshCount(); i++) {
        char *entry = meshEntry(model, i);
        const unsigned char *name = (const unsigned char *)meshName(entry);
        if (name != 0) {
            const unsigned char *other = (const unsigned char *)wanted;
            while (*name == *other && *name != 0) {
                name++;
                other++;
            }
            if (*name == *other) {
                *(unsigned int *)(entry + 0x38) = *(unsigned int *)(entry + 0x38) & 0xFFFFFFFE;
            }
        }
    }
}

