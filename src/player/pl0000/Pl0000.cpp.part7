};
inline void pushPoint(PointArray &points, float x, float y, float z)
{
    if (points.count < points.capacity) {
        float *p = points.data + points.count * 3;
        if (p != 0) {
            p[0] = x;
            p[1] = y;
            p[2] = z;
        }
        points.count = points.count + 1;
    }
}
// Hw::VecNormalize check: a zero-length vector is reported and replaced by (0, 1, 0).
// (The original also tests every component for NaN, which gives the same result as the > 0 test.)
inline void checkLength(float *v)
{
