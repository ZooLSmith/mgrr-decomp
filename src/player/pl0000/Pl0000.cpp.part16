// 0x150-byte collision hit record (FUN_00445db0 constructs it, FUN_00448f50 copies one)
struct HitRecord {
    int kind;                    // +0x00 attack kind (0x147 is skipped)
    int priority;                // +0x04 the hit with the highest priority is taken; damage given to vf30C
    int pad08[2];                // +0x08
    unsigned char reaction;      // +0x10 non-zero: vf21C(owner, reaction, 0.01f, 0)
    unsigned char strength;      // +0x11 0 .. 3: light, 4 / 5, 6 / 7, 8 .. 10
    unsigned char pad12[6];      // +0x12
    unsigned int handle;         // +0x18 attacker object handle
    int pad1C;                   // +0x1C
    float vec[4];                // +0x20 copied to vec2800
    float yaw;                   // +0x30 direction of the hit
    unsigned char pad34[0x58];   // +0x34
    unsigned int flags;          // +0x8C
    unsigned int flags2;         // +0x90
    unsigned char pad94[0xBC];   // +0x94
};

