// virtual call through slot `off` (byte offset) of an object whose class is not known here
template <class R> inline R vcall(void *obj, unsigned int off)
{
    return (*(R (__thiscall **)(void *))(*(char **)obj + off))(obj);
}
template <class R, class A> inline R vcall(void *obj, unsigned int off, A a)
{
    return (*(R (__thiscall **)(void *, A))(*(char **)obj + off))(obj, a);
}
template <class R, class A, class B> inline R vcall(void *obj, unsigned int off, A a, B b)
{
    return (*(R (__thiscall **)(void *, A, B))(*(char **)obj + off))(obj, a, b);
}
template <class R, class A, class B, class C> inline R vcall(void *obj, unsigned int off, A a, B b, C c)
{
    return (*(R (__thiscall **)(void *, A, B, C))(*(char **)obj + off))(obj, a, b, c);
}

// Sets (set = true) or clears bit 0 of the flags word (+0x38) of every mesh of `model` (0x70-byte
// entries, name at entry+0x60 -> +0x40) whose name contains `tag` (FUN_00fdbbd0 = strstr).
inline void setMeshFlag(cModelBase *model, const char *tag, bool set)
{
    for (int i = 0; i < model->meshCount(); i++) {
        char *mesh = (char *)model->meshArray() + i * 0x70;
        int name = *(int *)(*(int *)(mesh + 0x60) + 0x40);
        if (name != 0 && FUN_00fdbbd0((uint *)name, (char *)tag) != 0) {
            if (set) {
                *(unsigned int *)(mesh + 0x38) |= 1;
            } else {
                *(unsigned int *)(mesh + 0x38) &= 0xFFFFFFFE;
            }
        }
    }
}

// Maximum HP including the upgrades: maxHp() + FUN_00c13920()->vf98() * hpBonus1E40()
// (the upgrade part is skipped when DAT_01bea090 bit 31 is set).  Inlined in the original.
inline int maxHpTotal(Pl0000 *self)
{
    void *mgr = (void *)FUN_00c13920();
    int base = self->maxHp();
    if ((DAT_01bea090 & 0x80000000) == 0 && mgr != 0) {
        return vcall<int>(mgr, 0x98) * self->hpBonus1E40() + base;
    }
    return base;
}

// byte-wise string compare (inlined strcmp in the original): 0 when equal
inline int compareStr(const char *a, const char *b)
{
    while (*a == *b) {
        if (*a == 0) {
            return 0;
        }
        a++;
        b++;
    }
    return (unsigned char)*a < (unsigned char)*b ? -1 : 1;
}

