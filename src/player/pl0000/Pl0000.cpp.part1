    if (mode == 0) {
        if (DAT_01bea024 == 0xD) {
            setMeshFlag(self, "body", true);  // DAT_01640b88
            setMeshFlag(self, "saya_arm", true);
            setMeshFlag(self, "armor_no", true);
            setMeshFlag(self, "armor_dam", false);
            setMeshFlag(self, "blood_R", false);
            setMeshFlag(self, "blood_W", false);
            setMeshFlag(self, "back_guard", true);
            if (FUN_00a81330(&self->handleFE8()) != 0) {
                FUN_00a7c8a0((int)FUN_00a81330(&self->handleFE8()));  // result unused
            }
            if (FUN_00a81330(&self->handleB98()) != 0) {
                FUN_00a7c8a0((int)FUN_00a81330(&self->handleB98()));  // result unused
                return;
            }
        }
    } else if (mode == 1) {
        if (DAT_01bea024 == 0xD) {
            if (variant == 0) {
                setMeshFlag(self, "blood_R", true);
                setMeshFlag(self, "blood_W", false);
            } else {
                setMeshFlag(self, "blood_R", false);
                setMeshFlag(self, "blood_W", true);
            }
            ownerFE8(self);  // results unused
            ownerB98(self);
            return;
        }
    } else if (mode == 2 && DAT_01bea024 == 0xD) {
        setMeshFlag(self, "armor_no", false);
        setMeshFlag(self, "armor_dam", true);
    }
}

