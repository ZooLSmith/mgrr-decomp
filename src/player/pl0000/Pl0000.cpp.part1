// 00B7C060  FUN_00b7c060  size=1160  [between]
// Switches the armour / blood mesh variants of the player when DAT_01bea024 == 0xD.
void FUN_00b7c060(Pl0000 *self, int mode)  // __thiscall
{
    using namespace Pl0000_p2;
