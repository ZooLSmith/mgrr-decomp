            }
            FUN_00a8c930((int)self, 0, (int)&message);  // __thiscall
            self->field2BA4() = 1;
        }
    } else if (!inKind1) {
        call_00EAA6E0(self->esp2A40(), 90.0f, 0.0f);
        FUN_00e5e0c0((undefined4)"wp1040_se_grenade_kirakira_stop", (undefined4)self, 0xFFFFFFFF, 0);  // DAT_016a2618
        self->field2BA4() = 0;
    }
    if (self->field2BA8() != 0) {
        float remaining = self->field2BAC() - dt910(self);
        self->field2BAC() = remaining;
