// Euler angles (x, y, z) of the rotation part of `m` (float[16]; rows +0x00 / +0x10 / +0x20 normalised)
inline void matrixAngles(float *m, float *angles)
{
    float lenX = (float)sqrt((double)(m[0] * m[0] + m[1] * m[1] + m[2] * m[2]));
    float lenY = (float)sqrt((double)(m[4] * m[4] + m[5] * m[5] + m[6] * m[6]));
    float lenZ = (float)sqrt((double)(m[8] * m[8] + m[9] * m[9] + m[10] * m[10]));
    float zy = m[6] / lenZ;   // +0x28 / |row 2|
    float zz = m[10] / lenZ;  // +0x38 / |row 2|
    float ay = (float)FUN_00ddbaa0(-(m[2] / lenZ));  // ? asin
    angles[0] = (float)atan2((double)zy, (double)zz);
    angles[1] = ay;
    angles[2] = (float)atan2((double)(m[1] / lenY), (double)(m[0] / lenX));
}


