    }
    for (int k = 0; k < 6; k++) {
        paramEntry(self, 48 + k)[4] = vcall<float, int>((void *)self->field754(), 0x34, 0x13C + k);
    }
    // entries 72..107: 6 groups of 6 (-1 = group left untouched)
    int groupIds2[6] = {-1, -1, 0x161, 0x168, 0x16F, -1};
    float *groupBase = paramEntry(self, 72);
    for (int group = 0; group < 6; group++) {
