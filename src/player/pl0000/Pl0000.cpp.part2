            loadScaledParam(self, id, entry);
            entry += 5;
            id++;
        }
    }
    // unscaled values in entry[4] (obj754 is not re-checked for null here)
    for (int k = 0; k < 6; k++) {
        paramEntry(self, 6 + k)[4] = vcall<float, int>((void *)self->field754(), 0x34, 0x11B + k);
    }
    for (int k = 0; k < 6; k++) {
