// virtual call through slot `off` (byte offset) of an object whose class is not known here
template <class R> inline R vcall(void *obj, unsigned int off)
{
    return (*(R (__thiscall **)(void *))(*(char **)obj + off))(obj);
}
template <class R, class A> inline R vcall(void *obj, unsigned int off, A a)
{
    return (*(R (__thiscall **)(void *, A))(*(char **)obj + off))(obj, a);
}
template <class R, class A, class B, class C, class D>
inline R vcall(void *obj, unsigned int off, A a, B b, C c, D d)
{
    return (*(R (__thiscall **)(void *, A, B, C, D))(*(char **)obj + off))(obj, a, b, c, d);
}

// Entry `index` of the float parameter table at +0x142C (0x14-byte entries: [0..3] scaled
// parameters from obj754 slots 0x34 / 0x3C / 0x44 / 0x4C, [4] an unscaled slot-0x34 value).
inline float *paramEntry(Pl0000 *self, int index)
{
    return self->paramTable142C() + index * 5;
}

// Fills entry[0..3] with the parameters `id` of obj754 (slots 0x34 / 0x3C / 0x44 / 0x4C), each
// multiplied by the per-difficulty factor FUN_00b7ee70(id).
inline void loadScaledParam(Pl0000 *self, int id, float *entry)
{
    float scale = (float)FUN_00b7ee70((int)self, id);  // __thiscall
    void *table = (void *)self->field754();
    if (table != 0) {
        entry[0] = vcall<float, int>(table, 0x34, id) * scale;
        entry[1] = vcall<float, int>(table, 0x3C, id) * scale;
        entry[2] = vcall<float, int>(table, 0x44, id) * scale;
        entry[3] = vcall<float, int>(table, 0x4C, id) * scale;
    }
}

// Sets (set = true) or clears bit 0 of the flags word (+0x38) of every mesh of `model` (0x70-byte
// entries, name at entry+0x60 -> +0x40) whose name contains `tag` (FUN_00fdbbd0 = strstr).
inline void setMeshFlag(cModelBase *model, const char *tag, bool set)
{
    for (int i = 0; i < model->meshCount(); i++) {
        char *mesh = (char *)model->meshArray() + i * 0x70;
        int name = *(int *)(*(int *)(mesh + 0x60) + 0x40);
        if (name != 0 && FUN_00fdbbd0((uint *)name, (char *)tag) != 0) {
            if (set) {
                *(unsigned int *)(mesh + 0x38) |= 1;
            } else {
                *(unsigned int *)(mesh + 0x38) &= 0xFFFFFFFE;
            }
        }
    }
}

// Target slot test used all over the lock-on code: the object exists (FUN_00a81330 on its handle,
// which is its first member), its +0x34 is set, and the handle still resolves.
inline bool validTarget(int obj)
{
    return obj != 0 && FUN_00a81330((uint *)obj) != 0 && *(int *)(obj + 0x34) != 0 &&
           FUN_00a81330((uint *)obj) != 0;
}
// the same without the final re-check
inline bool validTarget3(int obj)
{
    return obj != 0 && FUN_00a81330((uint *)obj) != 0 && *(int *)(obj + 0x34) != 0;
}

