// Normalises the xz push direction vec2800 and adds it to move890 (y scaled by 0.15, x / z by 0.2);
// the y part replaces move890[1] when the normalised y is > 0.5.  Zero vector: nothing is done;
// zero or invalid length: the FUN_00dd5650 message and (0, 1, 0).  Shared body of FUN_00bf4280 / FUN_00bf46d0.
inline void applyPush2800(Pl0000 *self)
{
    float dir[4];
    dir[0] = self->vec2800()[0];
    dir[1] = self->vec2800()[1];
    dir[2] = self->vec2800()[2];
    dir[3] = self->vec2800()[3];
    if (dir[0] == 0.0f && dir[1] == 0.0f && dir[2] == 0.0f) {
        return;
    }
    float x;
    float y;
    float z;
    // (the original also tests every component for NaN, which gives the same result as the > 0 test)
    if (dir[0] * dir[0] + dir[1] * dir[1] + dir[2] * dir[2] > 0.0f) {
        FUN_00ddf460(dir, dir);
        if (!(dir[1] > 0.5f)) {
            float *move = self->move890();
            move[1] = dir[1] * 0.15f + move[1];
            move[0] = dir[0] * 0.2f + move[0];
            move[2] = dir[2] * 0.2f + move[2];
            return;
        }
        y = dir[1];
        x = dir[0];
        z = dir[2];
    } else {
        call_00DD5650(DAT_0163d0ac);
        y = 1.0f;
        x = 0.0f;
        z = 0.0f;
    }
    float *move = self->move890();
    move[1] = y * 0.15f;
    move[0] = x * 0.2f + move[0];
    move[2] = z * 0.2f + move[2];
}

